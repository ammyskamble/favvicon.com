---
// src/pages/[lang]/privacy-policy.astro
import Layout from '../../layouts/Layout.astro';
import PrivacyContent from '../../components/info/PrivacyContent.astro';
import { languages, defaultLang, type SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((l) => l !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
---
<Layout
  lang={lang}
  currentPath="privacy-policy"
  title="Privacy Policy — 100% Client-Side Private | Favvicon.com"
  description="Read the Favvicon.com privacy policy. Zero server uploads, zero file retention, and 100% client-side favicon generation."
>
  <PrivacyContent lang={lang} />
</Layout>
