  lang={lang}
  currentPath="terms"
  canonical="https://favvicon.com/terms-and-conditions/"
  title="Terms & Conditions — Free Developer Usage Agreement | Favvicon.com"
  description="Review the terms and conditions for using Favvicon.com. Retain 100% intellectual property ownership of all generated favicon packages."
>
  <TermsContent lang={lang} />
</Layout>
