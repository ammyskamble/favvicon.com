---
// src/components/info/ContactContent.astro
import { type SupportedLanguage } from '../../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
---
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
  
  <div class="text-center space-y-3">
    <span class="text-xs uppercase font-bold tracking-widest text-cyan-400 px-3.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20">
      Get in Touch
    </span>
    <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-[var(--foreground)]">
      Contact Us
    </h1>
    <p class="text-sm text-[var(--muted-foreground)] max-w-xl mx-auto">
      Have a question about favicon dimensions, custom integration requests, or bug reports? Our engineering team is here to assist.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Left Column: Contact Details (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      
      <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6 shadow-lg space-y-5">
        <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--foreground)] flex items-center gap-2">
          <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          Direct Inquiries
        </h2>

        <div class="space-y-4 text-xs">
          <div class="p-3.5 rounded-xl border border-[var(--border)] bg-[var(--muted)]/20 space-y-1">
            <span class="text-[var(--muted-foreground)] block">Support & Feedback Email:</span>
            <a href="mailto:support@favvicon.com" class="font-mono text-sm font-semibold text-cyan-400 hover:underline">
              support@favvicon.com
            </a>
          </div>

          <div class="p-3.5 rounded-xl border border-[var(--border)] bg-[var(--muted)]/20 space-y-1">
            <span class="text-[var(--muted-foreground)] block">Estimated Response Time:</span>
            <span class="font-medium text-[var(--foreground)]">Within 24 to 48 business hours</span>
          </div>

          <div class="p-3.5 rounded-xl border border-[var(--border)] bg-[var(--muted)]/20 space-y-1">
            <span class="text-[var(--muted-foreground)] block">Security & Vulnerability Reports:</span>
            <a href="mailto:security@favvicon.com" class="font-mono text-cyan-400 hover:underline">
              security@favvicon.com
            </a>
          </div>
        </div>
      </div>

      <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6 shadow-lg space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--foreground)]">
          Privacy Assurance
        </h3>
        <p class="text-xs text-[var(--muted-foreground)] leading-relaxed">
          Favvicon.com does not collect or store your uploaded image files. Any messages sent through this form are used exclusively to resolve your inquiry and are never shared with third parties.
        </p>
      </div>

    </div>

    <!-- Right Column: Interactive Contact Form (7 cols) -->
    <div class="lg:col-span-7">
      <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6 sm:p-8 shadow-xl space-y-6">
        
        <div>
          <h2 class="text-lg font-bold text-[var(--foreground)]">Send Us a Message</h2>
          <p class="text-xs text-[var(--muted-foreground)] mt-1">
            Fill out the form below and we will get back to you promptly.
          </p>
        </div>

        <!-- Contact Form -->
        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-xs font-semibold text-[var(--foreground)] mb-1.5">
                Your Name <span class="text-rose-400">*</span>
              </label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                placeholder="Jane Doe"
                class="w-full px-3.5 py-2.5 text-xs rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] text-[var(--foreground)] placeholder-[var(--muted-foreground)] focus:outline-none focus:ring-2 focus:ring-cyan-500/40 focus:border-cyan-500 transition-all"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-xs font-semibold text-[var(--foreground)] mb-1.5">
                Email Address <span class="text-rose-400">*</span>
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                placeholder="jane@example.com"
                class="w-full px-3.5 py-2.5 text-xs rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] text-[var(--foreground)] placeholder-[var(--muted-foreground)] focus:outline-none focus:ring-2 focus:ring-cyan-500/40 focus:border-cyan-500 transition-all"
              />
            </div>
          </div>

          <div>
            <label for="contact-subject" class="block text-xs font-semibold text-[var(--foreground)] mb-1.5">
              Subject <span class="text-rose-400">*</span>
            </label>
            <select
              id="contact-subject"
              name="subject"
              required
              class="w-full px-3.5 py-2.5 text-xs rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] text-[var(--foreground)] focus:outline-none focus:ring-2 focus:ring-cyan-500/40 focus:border-cyan-500 transition-all"
            >
              <option value="General Question">General Favicon Question</option>
              <option value="Tool Feedback">Tool Feedback & Suggestions</option>
              <option value="Bug Report">Bug Report / Issue</option>
              <option value="Partnership">Partnership & Media</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-semibold text-[var(--foreground)] mb-1.5">
              Your Message <span class="text-rose-400">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Describe your inquiry, issue, or question in detail..."
              class="w-full px-3.5 py-2.5 text-xs rounded-xl bg-[var(--muted)]/30 border border-[var(--border)] text-[var(--foreground)] placeholder-[var(--muted-foreground)] focus:outline-none focus:ring-2 focus:ring-cyan-500/40 focus:border-cyan-500 transition-all"
            ></textarea>
          </div>

          <!-- Submission Status Notice -->
          <div id="form-status" class="hidden p-3.5 rounded-xl text-xs font-medium"></div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-indigo-500 to-cyan-500 hover:from-indigo-600 hover:to-cyan-600 text-white font-bold text-xs shadow-md shadow-indigo-500/20 transition-all cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Send Message</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </form>

      </div>
    </div>

  </div>

</div>

<script is:inline>
  const form = document.getElementById('contact-form');
  const statusDiv = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!statusDiv || !submitBtn) return;

    submitBtn.setAttribute('disabled', 'true');
    submitBtn.innerHTML = 'Sending...';

    setTimeout(() => {
      statusDiv.className = 'p-3.5 rounded-xl text-xs font-medium bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 block';
      statusDiv.innerHTML = '✓ Thank you! Your message has been received. Our team will review your inquiry shortly at support@favvicon.com.';
      form.reset();
      submitBtn.removeAttribute('disabled');
      submitBtn.innerHTML = 'Message Sent!';
      setTimeout(() => {
        submitBtn.innerHTML = 'Send Another Message';
      }, 3000);
    }, 800);
  });
</script>
