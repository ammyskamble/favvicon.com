---
// src/components/info/AboutContent.astro
import { type SupportedLanguage, getRelativeLocaleUrl } from '../../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const homeUrl = getRelativeLocaleUrl(lang);
---
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
  
  <div class="text-center space-y-3">
    <span class="text-xs uppercase font-bold tracking-widest text-cyan-400 px-3.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20">
      Our Mission & Story
    </span>
    <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-[var(--foreground)]">
      About Favvicon.com
    </h1>
    <p class="text-sm text-[var(--muted-foreground)] max-w-xl mx-auto">
      Built by developers for developers. The next-generation favicon size reference matrix, asset validator, and client-side compilation engine.
    </p>
  </div>

  <div class="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6 sm:p-10 shadow-xl space-y-8 text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed">
    
    <section class="space-y-3">
      <h2 class="text-xl font-bold text-[var(--foreground)]">
        Why We Built Favvicon.com
      </h2>
      <p>
        For over a decade, creating a favicon meant visiting outdated converters that still outputted 20+ legacy files—such as Windows 8 Metro XML tiles and obsolete iPhone 3GS icons—or clicking through ad-heavy affiliate marketing websites that forced users through multi-step email capture forms.
      </p>
      <p>
        In <strong>2026</strong>, modern browser engines (Chromium, WebKit, and Gecko) have standardized around vector SVGs and streamlined fallbacks. We built <strong>Favvicon.com</strong> to provide an instantaneous, ultra-clean, ad-free developer utility that cuts through the noise and provides exact, modern dimensions in zero milliseconds.
      </p>
    </section>

    <!-- 4 Core Pillars -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-[var(--foreground)]">
        Our Core Engineering Pillars
      </h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--muted)]/20 space-y-2">
          <div class="font-bold text-sm text-cyan-400 flex items-center gap-2">
            <span>⚡ 100% Client-Side Engine</span>
          </div>
          <p class="text-xs text-[var(--muted-foreground)]">
            No server uploads, zero storage overhead, and zero privacy risks. Every image manipulation and binary ICO packing step executes locally in your browser.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--muted)]/20 space-y-2">
          <div class="font-bold text-sm text-indigo-400 flex items-center gap-2">
            <span>🎯 2026 Modern Standards</span>
          </div>
          <p class="text-xs text-[var(--muted-foreground)]">
            Focused on what modern web engines actually render: dynamic vector SVGs with dark/light mode switching, 48px Google SERP rules, and PWA manifest assets.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--muted)]/20 space-y-2">
          <div class="font-bold text-sm text-purple-400 flex items-center gap-2">
            <span>📱 Real-World Device Mockups</span>
          </div>
          <p class="text-xs text-[var(--muted-foreground)]">
            Inspect your icon in realistic Chrome dark/light tabs, Safari macOS chrome, Google SERP search results, and iOS/Android home screens before shipping.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--muted)]/20 space-y-2">
          <div class="font-bold text-sm text-emerald-400 flex items-center gap-2">
            <span>🚀 1-Click Production ZIP</span>
          </div>
          <p class="text-xs text-[var(--muted-foreground)]">
            Download perfectly bundled assets with ready-to-use HTML, Next.js, and Astro code snippets with zero guesswork.
          </p>
        </div>
      </div>
    </section>

    <section class="space-y-3 pt-4 border-t border-[var(--border)]">
      <h2 class="text-xl font-bold text-[var(--foreground)]">
        Technology Stack
      </h2>
      <p>
        Favvicon.com is engineered with cutting-edge web technologies:
      </p>
      <div class="flex flex-wrap gap-2 pt-1 text-xs font-mono">
        <span class="px-2.5 py-1 rounded-md bg-[var(--muted)] border border-[var(--border)] text-[var(--foreground)]">Astro.js</span>
        <span class="px-2.5 py-1 rounded-md bg-[var(--muted)] border border-[var(--border)] text-[var(--foreground)]">Tailwind CSS v4</span>
        <span class="px-2.5 py-1 rounded-md bg-[var(--muted)] border border-[var(--border)] text-[var(--foreground)]">React 19</span>
        <span class="px-2.5 py-1 rounded-md bg-[var(--muted)] border border-[var(--border)] text-[var(--foreground)]">HTML5 Canvas API</span>
        <span class="px-2.5 py-1 rounded-md bg-[var(--muted)] border border-[var(--border)] text-[var(--foreground)]">JSZip Client Packer</span>
        <span class="px-2.5 py-1 rounded-md bg-[var(--muted)] border border-[var(--border)] text-[var(--foreground)]">OKLCH Perceptual Colors</span>
      </div>
    </section>

    <div class="pt-4 text-center">
      <a
        href={`${homeUrl}#studio`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-indigo-500 to-cyan-500 hover:from-indigo-600 hover:to-cyan-600 text-white font-bold text-xs shadow-lg shadow-indigo-500/20 transition-all hover:scale-105 cursor-pointer"
      >
        <span>Launch Free Favicon Studio</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

  </div>

</div>
