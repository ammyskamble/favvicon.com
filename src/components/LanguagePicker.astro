---
// src/components/LanguagePicker.astro
import { languages, type SupportedLanguage, getRelativeLocaleUrl } from '../i18n/ui';

interface Props {
  currentLang?: SupportedLanguage;
  currentPath?: string;
}

const { currentLang = 'en', currentPath = '' } = Astro.props;
---
<div class="relative inline-block text-left group">
  <button
    type="button"
    class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-[var(--border)] bg-[var(--card)] text-[var(--foreground)] hover:bg-[var(--accent)] transition-colors focus:outline-none focus:ring-2 focus:ring-[var(--ring)] cursor-pointer"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <svg class="w-3.5 h-3.5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="uppercase font-mono">{currentLang}</span>
    <svg class="w-3 h-3 text-[var(--muted-foreground)] group-hover:translate-y-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div class="absolute right-0 z-50 mt-2 w-36 origin-top-right rounded-xl border border-[var(--border)] bg-[var(--card)] shadow-xl hidden group-hover:block group-focus-within:block py-1.5 focus:outline-none">
    {Object.entries(languages).map(([code, name]) => {
      const url = getRelativeLocaleUrl(code, currentPath);
      const isSelected = code === currentLang;
      return (
        <a
          href={url}
          class={`flex items-center justify-between px-3 py-2 text-xs transition-colors ${
            isSelected
              ? 'bg-cyan-500/15 text-cyan-400 font-semibold'
              : 'text-[var(--muted-foreground)] hover:text-[var(--foreground)] hover:bg-[var(--accent)]'
          }`}
        >
          <span>{name}</span>
          <span class="font-mono text-[10px] uppercase opacity-70">{code}</span>
        </a>
      );
    })}
  </div>
</div>
